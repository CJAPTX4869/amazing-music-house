# 复制为 .env.local 后填入真实值：  copy .env.example .env.local
MYSQL_USERNAME=
MYSQL_PASSWORD=
# 需要连别的机器时再打开：
# MYSQL_URL=jdbc:mysql://127.0.0.1:3306/music_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# 生产环境必须设置，用 openssl rand -base64 48 生成：
# JWT_SECRET=
RECOVERY_CODE=把这里换成你自己的恢复码
