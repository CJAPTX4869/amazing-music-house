<script setup lang="ts">
import { useThemeVars } from 'naive-ui';
import obverser from '@/utils/obverser';
import { PlayArrowSharp } from '@vicons/material';
import { computed, nextTick, onBeforeUnmount, onMounted, toRaw, watch, type CSSProperties } from 'vue';
import color from 'color';
import { useMainStore } from '@/stores/main';
import { ref } from 'vue';
import { parseLyric, parseRangeLyric, type LyricItem, parseBaseLyric, type RangeLyricItem } from '@/utils/lyric';
import { useElementHover } from '@vueuse/core';
let timeId: any;// 回退滚动位置延时器
let clearTriggerScrollTimer: any;// 设置滚动是否触发延时器
let triggerScroll = true;
let triggerPlayLyric = true;
// 用户是否正在手动浏览歌词（滚轮/滚动）：此时不把视图强行拉回当前行
let browsingLyric = false;
let selectLyricLineIndex = 0;
let pendingSetScrollFn: (() => void) | null = null;
const mainStore = useMainStore();
const themeVars = useThemeVars();
const currentPlayLine = ref(0);
const selectLyricLine = ref<{ time: number; index: number, middleTop: number } | null>();// 当前鼠标/滚动选中的歌词
const showSelectLyric = ref(false);
const lyricContainer = ref<HTMLDivElement>();
const scrollBarRef = ref<{ scrollTo: (data: { left?: number, top?: number, behavior: string }) => void }>();
const scrollContainerRef = ref();
const footerMaskBackground = ref<CSSProperties>({});
const topMaskBackground = ref<CSSProperties>({});

const isHover = useElementHover(scrollContainerRef);
let audioEle: HTMLAudioElement | null = null;
let animatingId: number;
const activeLyricStyle = ref({
  backgroundImage: '',
  WebkitTextFillColor: 'transparent',
  fontWeight: 'bold',
  fontSize: '18px'
} as CSSProperties);

let lyricContainerEle: null | HTMLDivElement = null;
let currentScrollTop = 0;
// 单行歌词的行高，必须与 <style> 里 .lyric-item p 的 line-height 保持一致
const LINE_HEIGHT = 38;
let lyricItemHeight = LINE_HEIGHT;
// 顶部留白只留一点点：歌曲开头第一行就贴着歌词区顶部（网易云：开头贴顶、播放中才居中）
const TOP_GAP = 8;
const hasTlyric = computed(() => {
  return mainStore.currentPlaySong?.tlyric !== '' && mainStore.currentPlaySong?.tlyric !== undefined;
});
// 歌词区高度跟随视口：一屏尽量多显示行（14 行以上），窗口变小也不会溢出
const containerHeight = ref(320);
// 底部留白 = 容器高度的一半 + 一行：最后几行才有空间滚到中间（顶部留白已拆开，不再是半屏）
const bottomGap = ref(160);
const updateLyricMetrics = () => {
  // 视口 - 底部播放栏 68 - 顶部栏 77 - 歌曲信息区约 98 - 信息区上间距/歌词上间距约 28
  // （预留量必须够，否则歌词区比可视区高，播放页会冒出外层滚动条）
  const available = window.innerHeight - 68 - 77 - 126;
  const height = Math.round(Math.min(780, Math.max(200, available)));
  containerHeight.value = height;
  bottomGap.value = Math.round(height / 2) + LINE_HEIGHT;
};
// 歌词滚动容器（naive-ui 内部节点）：DOM 查询一次后复用
const getScrollContainer = () => {
  if (!lyricContainerEle) {
    lyricContainerEle = document.querySelector('.scrollContainer > .n-scrollbar > .n-scrollbar-container') as HTMLDivElement;
  }
  return lyricContainerEle;
};
updateLyricMetrics();



const lyricData = computed(() => {
  let tlyricData: LyricItem[] | undefined;
  if (mainStore.currentPlaySong?.tlyric) {
    tlyricData = parseBaseLyric(mainStore.currentPlaySong?.tlyric);
  }
  if (!mainStore.currentPlaySong?.lyric) {
    return [];
  } else {
    let lyric = parseLyric(mainStore.currentPlaySong?.lyric, mainStore.currentPlaySong?.yrcLyric);
    if (tlyricData) {
      // 过滤掉歌词中的[]部分
      lyric.filter((item) => !/^\[[^\d\]]+\]$/.test(item.content) && item.index != undefined).forEach((item, index) => {
        if (tlyricData[index]) {
          item.translateContent = tlyricData[index].content;
        }
        return item;
      });
      return lyric;
    } else {
      return lyric;
    }
  }
});


const rangeLyricList = computed(() => {
  return parseRangeLyric(toRaw(lyricData.value));
});
// 同色减淡（配置的歌词色非法时直接返回原色，保证渲染不崩）
const withAlpha = (hex: string, alpha: number) => {
  try {
    return color(hex).alpha(alpha).rgb().string();
  } catch (e) {
    return hex;
  }
};
// 歌词底色：播放页自定义色优先，否则跟随主题（深色亮白 / 浅色近黑）
const lyricBaseColor = computed(() => {
  if (mainStore.playerLyricColor) return mainStore.playerLyricColor;
  return mainStore.isDark
    ? '#ffffff'
    : '#1a1a1a';
});
const currentLyricStyle = computed(() => {
  const base = lyricBaseColor.value;
  // 非当前行：同色减淡（对齐网易云「当前行亮、其余行暗」的层次）
  const normalColor = withAlpha(base, 0.5);
  return (index: number) => {
    let isCurrent = index === currentPlayLine.value;
    return {
      color: isCurrent
        ? base
        : selectLyricLine.value?.index === index
          ? themeVars.value.primaryColor
          : normalColor,
      fontWeight: isCurrent
        ? '600'
        : '400',
      fontSize: isCurrent
        ? '18px'
        : '16px'
    } as CSSProperties;

  };
});
function handlePlayLyric(time: number, listenScroll = false) {
  // 用户正在手动浏览歌词时不抢滚动（悬停本身不算，否则鼠标停在歌词上会自动滚动失效）
  if (browsingLyric) return;
  if (!triggerPlayLyric) return;
  triggerLyricChange(time, listenScroll);
}
const handleSliderChange = (time: number, listenScroll = false) => {
  if (mainStore.showMusicDetail) {
    triggerLyricChange(time, listenScroll);
  } else {
    pendingSetScrollFn = () => triggerLyricChange(time, listenScroll);
  }
};

const triggerLyricChange = (time: number, listenScroll = false) => {
  if (mainStore.currentPlaySong.isNotLyric) return;
  if (!lyricData.value.length) return;

  //匹配最后一个歌词
  if (time > lyricData.value[lyricData.value.length - 1].time) {
    let currentLyric = lyricData.value[lyricData.value.length - 1];
    currentPlayLine.value = lyricData.value.length - 1;
    mainStore.currentPlayLyric = currentLyric.content;
    setScroll(currentLyric.time, listenScroll);
  } else {
    let currentLyric = rangeLyricList.value.get(time) as RangeLyricItem;
    if (currentLyric) {
      currentPlayLine.value = currentLyric.index;
      mainStore.currentPlayLyric = currentLyric.content;
      setScroll(currentLyric.time, listenScroll);
    }
  }
  // 正在显示定位标时，滚动会改变行的屏幕位置：这里跟着重新贴合，避免"标在字上面乱飘"
  if (showSelectLyric.value && hoverClientY) {
    updateSelectByClientY(hoverClientY);
  }
};

// 鼠标在歌词区内的纵坐标（滚动/悬停时用它判断“鼠标压在哪一行”）
let hoverClientY = 0;
const handleMouseMove = (event: MouseEvent) => {
  hoverClientY = event.clientY;
  // 悬停即定位：鼠标压在哪一行，哪一行就出时间 + 播放按钮（网易云行为）
  if (isHover.value && !mainStore.currentPlaySong?.isNotLyric) {
    updateSelectByClientY(hoverClientY);
  }
};
/**
 * 按屏幕坐标命中歌词行。
 * <p>
 * 位置全部取自 DOM 实测（行的 getBoundingClientRect），因此不管当前是
 * 「开头贴顶」还是「中段居中」，也不管窗口怎么缩放，定位标都不会算错、不会与歌词重叠。
 */
const updateSelectByClientY = (clientY: number) => {
  const container = scrollContainerRef.value as HTMLElement | undefined;
  const list = lyricContainer.value;
  if (!container || !list || !clientY) return false;
  const baseTop = container.getBoundingClientRect().top;
  const relativeY = clientY - baseTop;
  const rows = Array.from(list.children) as HTMLElement[];
  for (let index = 0; index < rows.length; index++) {
    const rect = rows[index].getBoundingClientRect();
    const top = rect.top - baseTop;
    if (relativeY >= top && relativeY < top + rect.height) {
      selectLyricLine.value = {
        index,
        time: +rows[index].getAttribute('data-time')!,
        middleTop: Math.round(top)
      };
      selectLyricLineIndex = index;
      if (!mainStore.currentPlaySong?.isNotLyric) {
        showSelectLyric.value = true;
      }
      return true;
    }
  }
  return false;
};
const handleScroll = () => {
  if (!triggerScroll) return;
  if (mainStore.currentPlaySong.isNotLyric) return;
  triggerScroll = true;
  // 滚动后行的屏幕位置变了：重新按鼠标位置定位（否则定位标会停在上一次的坐标上）
  if (!updateSelectByClientY(hoverClientY)) return;

  browsingLyric = true;
  clearTimeout(timeId);
  timeId = setTimeout(() => {
    browsingLyric = false;
    if (selectLyricLineIndex && selectLyricLineIndex !== currentPlayLine.value) {
      triggerPlayLyric = false;
      scrollTo(currentScrollTop, true);
    }
    selectLyricLine.value = null;
    showSelectLyric.value = false;
  }, 2500);
};
const handlePlayIconClick = () => {
  let time = selectLyricLine.value!.time;
  currentPlayLine.value = selectLyricLine.value!.index;
  selectLyricLineIndex = currentPlayLine.value;
  showSelectLyric.value = false;
  triggerScroll = false;
  selectLyricLine.value = null;
  obverser.emit('selectLyricPlay', time / 1000);
};
const handleWheel = (event: WheelEvent) => {
  // 逐行滚动（原生边界自动夹紧）
  event.preventDefault();
  const container = getScrollContainer();
  if (!container) return;
  triggerScroll = true;
  const step = event.deltaY > 0
    ? lyricItemHeight
    : -lyricItemHeight;
  container.scrollTop = Math.floor(container.scrollTop + step);
  clearTimeout(clearTriggerScrollTimer);
  clearTriggerScrollTimer = setTimeout(() => {
    triggerScroll = false;
  }, 500);
};
/**
 * 让当前行居中：滚动到「行中心 - 容器中心」，再夹紧到 0..maxScroll。
 * <p>
 * 夹紧之后就自然得到网易云的行为：开头几行贴着顶部（不滚）、
 * 中段当前行停在正中间、结尾几行贴着底部。
 */
const setScroll = (time: number, listen = false) => {
  const targetELe = document.querySelector(`#time${time}`) as HTMLElement | null;
  if (!targetELe) return;
  const container = getScrollContainer();
  const centered = targetELe.offsetTop + targetELe.offsetHeight / 2 - containerHeight.value / 2;
  const maxScroll = container
    ? Math.max(0, container.scrollHeight - container.clientHeight)
    : Number.MAX_SAFE_INTEGER;
  const targetTop = Math.round(Math.min(maxScroll, Math.max(0, centered)));
  currentScrollTop = targetTop;
  scrollTo(targetTop, listen);
};
const scrollTo = (top: number, listen = false) => {
  triggerScroll = false;
  scrollBarRef.value?.scrollTo({ top: top, behavior: 'smooth' });
  if (listen) {
    listenScrollComplete(top, () => {
      obverser.emit('scrollComplete');
      triggerPlayLyric = true;
    });
  }

};
const createListenScrollComplete = (selector = '.scrollContainer > .n-scrollbar > .n-scrollbar-container', wait = 50) => {
  let scrollTargetEle: null | HTMLElement = null;
  let timer: any;
  return async (top: number, callback: () => void) => {
    await nextTick();
    if (!scrollTargetEle) {
      scrollTargetEle = document.querySelector(selector) as HTMLElement;
    }
    timer = setInterval(() => {
      if (scrollTargetEle?.scrollTop === top) {
        callback();
        clearInterval(timer);
      }
    }, wait);
  };
};
let listenScrollComplete = createListenScrollComplete();
watch(isHover, (val) => {
  if (!val) {
    showSelectLyric.value = false;
    // 鼠标离开：清掉选中行，避免残留选中挡住自动滚动
    selectLyricLine.value = null;
    return;
  }
  // 鼠标移入：直接选中鼠标下的那一行（网易云同样是悬停即出现播放按钮）
  if (!mainStore.currentPlaySong?.isNotLyric && hoverClientY) {
    updateSelectByClientY(hoverClientY);
  }
  showSelectLyric.value = !!selectLyricLine.value && !mainStore.currentPlaySong?.isNotLyric;
});
watch(() => mainStore.currentPlaySong, async () => {
  currentScrollTop = 0;
  scrollTo(0, true);
});
watch(
  () => mainStore.showMusicDetail, (val) => {
    if (val) {
      setTimeout(() => {
        pendingSetScrollFn && pendingSetScrollFn();
      }, 500);
    } else {
      pendingSetScrollFn = null;
    }
  }, { immediate: true }
);

const loopMatchLyric = () => {
  let time = Math.round(audioEle!.currentTime * 1000);
  let currentLyric = rangeLyricList.value.get(time) as RangeLyricItem;
  if (mainStore.currentPlaySong?.yrcLyric && currentLyric?.words?.length) {
    let j = 1
    const children = currentLyric.words;
    while (j < children.length) {
      if (time < children[j].startTime) {
        break
      } else {
        j++
      }
    }
    j = j - 1;
    const percent = j / children.length;
    const wordPercent = ((time) - children[j].startTime) / (children[j].duration) * (1 / children.length)
    const keyStyle = `-webkit-linear-gradient(left, ${themeVars.value.primaryColor} ${percent * 100 + wordPercent * 100}%, rgb(100,100,99) 0%)`
    activeLyricStyle.value.backgroundImage = keyStyle;
  }
  animatingId = requestAnimationFrame(loopMatchLyric)
}

watch(() => mainStore.playing, (val) => {
  if (val) {
    animatingId = requestAnimationFrame(loopMatchLyric)
  } else {
    cancelAnimationFrame(animatingId)
  }
})
watch(
  lyricData, (val) => {
    if (val.length) {
      mainStore.currentPlayLyric = val[0].content;
    }
  }, { immediate: true }
);
obverser.on('updateLyricMaskStyle', ({ footerMaskStyle, topMaskStyle }) => {
  footerMaskBackground.value = footerMaskStyle;
  topMaskBackground.value = topMaskStyle;

});
let resizeTimer: any;
// 窗口尺寸变化后歌词区高度与每行的定位都要重算，否则高亮行和定位标会错位、重叠
const handleResize = () => {
  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(async () => {
    updateLyricMetrics();
    await nextTick();
    if (!mainStore.showMusicDetail || mainStore.currentPlaySong?.isNotLyric) return;
    const current = lyricData.value[currentPlayLine.value];
    if (current) {
      setScroll(current.time);
    }
  }, 200);
};

onMounted(() => {
  obverser.on('timeUpdate', handlePlayLyric);
  obverser.on('slideValueChange', handleSliderChange);
  audioEle = document.querySelector('#audioEle')
  lyricContainerEle = document.querySelector('.scrollContainer > .n-scrollbar > .n-scrollbar-container')
  obverser.on('ended', () => {
    currentScrollTop = 0;
    scrollTo(0, true);
  });
  window.addEventListener('resize', handleResize);
  // 跟踪鼠标纵坐标：定位标按「鼠标压在哪一行」定位
  scrollContainerRef.value?.addEventListener('mousemove', handleMouseMove);
});

onBeforeUnmount(() => {
  window.removeEventListener('resize', handleResize);
  scrollContainerRef.value?.removeEventListener('mousemove', handleMouseMove);
  clearTimeout(resizeTimer);
});


</script>

<template>
  <div ref="scrollContainerRef" class="relative mt-3 scrollContainer"> <n-scrollbar ref="scrollBarRef"
      class="lyricScroll" :style="{ height: containerHeight + 'px', }" :on-scroll="handleScroll"
      @wheel="handleWheel">
      <div :style="{ height: TOP_GAP + 'px' }" />
      <div v-if="!mainStore.currentPlaySong?.isNotLyric" ref="lyricContainer">
        <div v-for="(item, index) in lyricData" :id="'time' + item.time" :key="index" class="lyric-item"
          :data-time="item.time">
          <div class="cur-lrc"
            :style="mainStore.currentPlaySong?.yrcLyric && lyricData[index].words ? currentPlayLine == index ? activeLyricStyle : {} : currentLyricStyle(index)">
            <p :style="currentLyricStyle(index)" class="transition-color">
              {{ item.content }}
            </p>
            <p v-if="item.translateContent" :style="currentLyricStyle(index)" class="transition-color">
              {{ item.translateContent }}
            </p>
          </div>
        </div>
      </div>
      <div v-else class="text-left opacity-40">
        {{ mainStore.currentPlaySong?.lyric ? '纯音乐，请欣赏' : '暂无歌词' }}
      </div>
      <div :style="{ height: bottomGap + 'px' }" />
    </n-scrollbar>
    <!-- 歌词定位标：固定在右栏留白区（歌词已预留 padding-right），任何窗口宽度下都不会压住歌词 -->
    <div v-if="showSelectLyric" class="selectLyricContainer"
      :style="{ top: selectLyricLine.middleTop + 'px', height: lyricItemHeight + 'px' }">
      <n-time v-if="selectLyricLine" class="select-time" format="mm:ss" :time="selectLyricLine?.time" />
      <button class="select-play" title="从这句开始播放" @click="handlePlayIconClick">
        <n-icon :component="PlayArrowSharp" :size="15" />
      </button>
    </div>
    <div class="top-mask" :style="topMaskBackground" />
    <div class="footer-mask" :style="footerMaskBackground" />
  </div>
</template>

<style scoped lang="less">
.lyric-item {
  /* 宽度跟随右栏，歌词左对齐（网易云播放页排版） */
  width: 100%;
  text-align: left;
  /* 右侧预留定位标（时间 + 播放按钮）的位置：窗口再窄也不会与歌词文字重叠 */
  padding-right: 92px;

  p {
    /* 行高 38px：一屏可显示 14 行以上（网易云播放页的字距密度），如需调整请同步 LINE_HEIGHT */
    line-height: 38px;
    color: rgba(128, 128, 128, .85);
  }
}

/* 隐藏歌词框与滚动条 + 首尾行淡出：与网易云一致，只留文字。
   必须用 :deep() 命中 naive-ui 的 .n-scrollbar —— 组件根节点不会带上本组件的
   scoped data-v 属性，直接写 .lyricScroll 类名规则是不会生效的（实测踩过）。 */
.scrollContainer :deep(.n-scrollbar) {
  background: transparent !important;
  /* 首尾行淡出：第一行与最后一行颜色自然减淡（网易云效果），留一点底色避免"切掉"的硬边 */
  -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, .1) 0, rgba(0, 0, 0, .5) 34px, #000 86px, #000 calc(100% - 86px), rgba(0, 0, 0, .5) calc(100% - 34px), rgba(0, 0, 0, .1) 100%);
  mask-image: linear-gradient(to bottom, rgba(0, 0, 0, .1) 0, rgba(0, 0, 0, .5) 34px, #000 86px, #000 calc(100% - 86px), rgba(0, 0, 0, .5) calc(100% - 34px), rgba(0, 0, 0, .1) 100%);
}

.scrollContainer :deep(.n-scrollbar),
.scrollContainer :deep(.n-scrollbar-container),
.scrollContainer :deep(.n-scrollbar-content) {
  background: transparent !important;
  scrollbar-width: none;
}

.scrollContainer :deep(.n-scrollbar-container)::-webkit-scrollbar {
  width: 0;
  height: 0;
}

.scrollContainer :deep(.n-scrollbar-rail) {
  display: none !important;
}

/* 旧的渐隐遮罩：保留 DOM（useBlurLineGradient 会读取它的位置），但不再显示 */
.footer-mask,
.top-mask {
  display: none;
}

.selectLyricContainer {
  position: absolute;
  left: 0;
  right: 0;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 10px;
  padding-right: 10px;
  /* 只有播放按钮可点，其余区域不挡歌词的滚轮 / 选择 */
  pointer-events: none;
}

.select-time {
  font-size: 12px;
  opacity: .6;
}

.select-play {
  pointer-events: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  padding: 0;
  border: none;
  border-radius: 50%;
  cursor: pointer;
  color: #fff;
  background: rgba(128, 128, 128, .5);
  transition: background .2s ease, transform .2s ease;
}

.select-play:hover {
  background: var(--primary);
  transform: scale(1.06);
}

.cur-lrc {
  display: inline-block;
  background-clip: text;
  -webkit-background-clip: text;
}
</style>
