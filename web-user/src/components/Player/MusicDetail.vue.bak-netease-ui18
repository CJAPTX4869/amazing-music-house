<script setup lang="ts">
import { ref, computed, type Ref, watch, reactive, nextTick, type CSSProperties, onMounted, onBeforeUnmount } from 'vue';
import { useRouter } from 'vue-router';
import { BackToTop } from '@vicons/carbon';
import { debounce, throttle } from '@/utils';
import {
  KeyboardArrowDownOutlined, FullscreenOutlined, FullscreenExitOutlined,
  BrushOutlined
} from '@vicons/material';
import { ChatbubbleEllipsesOutline } from '@vicons/ionicons5';
import color from 'color';
import { useMainStore } from '@/stores/main';
import useThemeStyle from '@/hook/useThemeStyle';
import { useBlurLineGradient } from './hook/useBlurLineGradient';
import { analyze } from '@/utils/image';

export interface MusicDetailExpose {
  show: () => void;
  close: () => void;
  toggle: () => void;
  active: Ref<boolean>;
}

const mainStore = useMainStore();
const { tagColor } = useThemeStyle();
const { updateFooterMaskColor, resetBackground } = useBlurLineGradient();

/* ===== 播放页（对齐网易云播放页）派生数据 ===== */
// 背景层：专辑封面重模糊 + 压暗；封面缺失时不渲染该层，露出 canvas 底色
const coverBgStyle = computed(() => {
  const url = mainStore.currentPlaySong?.al?.picUrl;
  return url
    ? { backgroundImage: `url("${url}")` }
    : {};
});
// 音质标签：只有接口真的返回了对应音质才显示（不硬造 SQ/HQ）
const qualityTag = computed(() => {
  const song = mainStore.currentPlaySong;
  if (!song) return '';
  if (song.hr) return 'HR';
  if (song.sq) return 'SQ';
  if (song.h) return 'HQ';
  return '';
});
// 歌手文案：ar 缺失或为空时兜底，避免详情页出现空白行
const artistText = computed(() => {
  const ar = mainStore.currentPlaySong?.ar;
  if (!Array.isArray(ar) || ar.length === 0) return '未知歌手';
  const names = ar.map((item: any) => item?.name).filter(Boolean);
  return names.length
    ? names.join(' / ')
    : '未知歌手';
});
/* ===== 播放页专属外观设置：背景透明度 / 歌词字体颜色 =====
   只写 playerBgOpacity、playerLyricColor 两个播放页字段，
   与主页「外观设置 → 自定义背景」的 appBgImage / appBgMask 完全独立 */
const LYRIC_COLOR_SWATCHES = ['#ffffff', '#eaeaea', '#f0c02e', '#f0655a', '#f25d8e', '#4a7cf0', '#41b3e0', '#7ec832'];
// 调色盘初值：未自定义时给出当前主题下的默认歌词色
const defaultLyricColor = computed(() => (mainStore.isDark
  ? '#ffffff'
  : '#1a1a1a'));
const handleBgOpacityChange = (value: number) => {
  mainStore.setPlayerBgOpacity(value);
};
const handleLyricColorChange = (value: string | null) => {
  mainStore.setPlayerLyricColor(value || '');
};
const handleResetLyricColor = () => {
  mainStore.setPlayerLyricColor('');
  window.$message?.success('歌词颜色已恢复默认');
};
const scrollContainerRef = ref<HTMLElement>(null as unknown as HTMLElement);
const myCanvas = ref<HTMLCanvasElement>();
const titleRef = ref<HTMLElement>();
const isShowTag = ref(false);
const showTopLyric = ref(false);
const tagPositionStyle = ref<CSSProperties>();
const fullScreen = ref(false);
const showBackTop = ref(false);
const target = () => scrollContainerRef.value;

// 查看评论：收起播放弹层后跳转歌曲评论页（V3.1）
const router = useRouter();
const goCommentPage = () => {
  const songId = mainStore.currentPlaySong?.id;
  if (!songId) return;
  mainStore.setShowMusicDetail(false);
  router.push(`/comment/song/${songId}`);
};

const fillBackground = async (updateMask = true) => {
  await nextTick();
  let ctx = myCanvas.value!.getContext('2d', { willReadFrequently: true }) as CanvasRenderingContext2D;
  // 播放页改为整屏铺满（与网易云播放页一致），画布尺寸同步为整屏，保证取色坐标与视口一致
  let width = window.innerWidth;
  let height = window.innerHeight - 68;
  if (!mainStore.currentPlaySong) return;
  let baseColor = mainStore.theme === 'dark'
    ? '#121212'
    : 'white';
  ctx.fillStyle = baseColor;
  ctx.fillRect(
    0, 0, width, height
  );
  let primary;
  let resultColor = mainStore.primaryColorMap[mainStore.currentPlaySong.id];
  if (!resultColor) {
    // al / picUrl 可能缺失（歌曲专辑信息不全），analyze 内部已兜底，这里保证不抛错
    const result = await analyze(mainStore.currentPlaySong.al?.picUrl);
    mainStore.updatePrimaryColorMap(mainStore.currentPlaySong.id, result);
    primary = result;
  } else {
    primary = resultColor;
  }
  let bgColor = color(baseColor).mix(color(primary), 0.2)
    .hex();
  myCanvas.value!.width = width;
  myCanvas.value!.height = height;
  let gradient = ctx!.createLinearGradient(
    width / 2, 0, width / 2, height
  );
  gradient.addColorStop(0, bgColor);
  gradient.addColorStop(1, baseColor);
  ctx.fillStyle = gradient;
  mainStore.canvasBackground = `linear-gradient(${baseColor}, ${bgColor})`;
  ctx.fillRect(
    0, 0, width, height
  );
  if (updateMask) {
    updateFooterMaskColor(ctx);
  }
};

const handleScroll = (e: Event) => {
  let target = e.target as HTMLElement;
  if (target.scrollTop >= 120) {
    showTopLyric.value = true;
  } else if (target.scrollTop === 0) {
    showTopLyric.value = false;
  }
  updateFooterMaskColor(myCanvas.value!.getContext('2d')!);
};

const handleUpdateShow = (value: boolean) => {
  showBackTop.value = value;
};

const handleContextMenu = (ev: MouseEvent) => {
  ev.preventDefault();
  return false;
};

const handleTransitionAfterEnter = () => {
  updateFooterMaskColor(myCanvas.value!.getContext('2d')!);
};

const setTagPositionStyle = async () => {
  await nextTick();
  isShowTag.value = false;
  let left = titleRef.value!.offsetLeft + titleRef.value!.offsetWidth + 20;
  tagPositionStyle.value = { left: left + 'px', top: '-15px' };
  isShowTag.value = true;
};

const toggleFullScreen = () => {
  if (!document.fullscreenElement) {
    document.documentElement.requestFullscreen();
    fullScreen.value = true;
  } else if (document.exitFullscreen) {
    document.exitFullscreen();
    fullScreen.value = false;
  }
};

watch(() => mainStore.theme, () => {
  resetBackground();
  fillBackground(mainStore.showMusicDetail);
});

watch(() => mainStore.showMusicDetail, async (val) => {
  if (!val) {
    showBackTop.value = false;
  }
  if (!isShowTag.value) {
    setTagPositionStyle();
  }
});

watch(
  () => mainStore.currentPlaySong, (val, oldVal) => {
    if (oldVal && val.id === oldVal.id) return;
    if (oldVal && val.id !== oldVal.id) {
      resetBackground();
    }
    if (mainStore.showMusicDetail) {
      fillBackground();
    } else {
      fillBackground(false);
    }
    isShowTag.value = false;
    if (mainStore.showMusicDetail) {
      setTagPositionStyle();
    }
  }, { immediate: true }
);

onMounted(() => {
  document.addEventListener("fullscreenchange", handleFullscreenchange);
  window.addEventListener('resize', handleResize);
});

onBeforeUnmount(() => {
  window.removeEventListener('resize', handleResize);
  document.removeEventListener("fullscreenchange", handleFullscreenchange);
});

const handleResize = throttle(() => {
  if (mainStore.showMusicDetail) {
    fillBackground(true);
  }
}, 300);

const handleFullscreenchange = () => {
  fullScreen.value = !!document.fullscreenElement;
  setTimeout(() => {
    fillBackground(true);
  });
};
</script>

<template>
  <transition name="bottom-slide-transform" @after-enter="handleTransitionAfterEnter">
    <div v-show="mainStore.showMusicDetail" class="fixed inset-x-0 m-auto music-detail"
      :class="[mainStore.isDark ? 'detail-dark' : 'detail-light', mainStore.appBgImage ? 'detail-has-appbg' : '']"
      :style="{ '--player-bg-opacity': String(mainStore.playerBgOpacity / 100) }">
      <!-- 背景层：设了主页自定义背景就用那张图铺满，否则用封面重模糊；最上面是压暗遮罩。
           两者的可见度都由播放页自己的「背景透明度」滑块控制（不动主页的遮罩强度） -->
      <div v-if="mainStore.appBgImage" class="detail-bg detail-bg-app"
        :style="{ backgroundImage: `url(${mainStore.appBgImage})` }" />
      <div v-else class="detail-bg" :style="coverBgStyle" />
      <div class="detail-bg-mask" />
      <div class="box-border flex items-center detail-header" style="height:77px;">
        <div class="flex items-center">
          <div class="ml-4 cursor-pointer">
            <n-icon size="35" :component="KeyboardArrowDownOutlined" @click="mainStore.setShowMusicDetail(false)" />
          </div>
        </div>
        <!-- 滚动后吸附在顶部的歌名 + 当前歌词（网易云放在左侧） -->
        <transition v-show="showTopLyric" name="slide">
          <div class="ml-6 text-left top-lyric">
            <p class="top-song-name">
              {{ mainStore.currentPlaySong?.name }}
            </p>
            <p class="opacity-50">
              {{ mainStore.currentPlayLyric }}
            </p>
          </div>
        </transition>
        <div class="flex items-center ml-auto">
          <!-- 播放页专属设置：歌词字体颜色 + 背景透明度（同一个按钮、同一个弹层） -->
          <n-popover trigger="click" placement="bottom-end">
            <template #trigger>
              <div class="ml-4 cursor-pointer player-setting-btn" title="歌词颜色 / 背景透明度">
                <n-icon size="24" :component="BrushOutlined" />
              </div>
            </template>
            <div class="setting-panel">
              <p class="setting-title">歌词字体颜色</p>
              <n-color-picker :value="mainStore.playerLyricColor || defaultLyricColor" :show-alpha="false"
                :swatches="LYRIC_COLOR_SWATCHES" :on-update:value="handleLyricColorChange" />
              <div class="flex items-center justify-between">
                <span class="setting-tip">当前行用所选颜色高亮，其余行自动减淡</span>
                <n-button size="tiny" quaternary @click="handleResetLyricColor">默认</n-button>
              </div>

              <div class="setting-divider" />

              <p class="setting-title">背景透明度</p>
              <div class="flex items-center">
                <div style="width:170px">
                  <n-slider :value="mainStore.playerBgOpacity" :min="0" :max="100" :step="1"
                    :on-update:value="handleBgOpacityChange" />
                </div>
                <span class="setting-value">{{ mainStore.playerBgOpacity }}%</span>
              </div>
              <p class="setting-tip">0% 只剩底色，100% 背景最明显（只影响播放页，不动主页自定义背景）</p>
              <p v-if="mainStore.appBgImage" class="setting-tip">
                当前用的是主页「自定义背景」那张图，拉到 0% 可完全隐藏
              </p>
            </div>
          </n-popover>

          <div class="ml-4 cursor-pointer">
            <n-icon size="30" :component="fullScreen ? FullscreenExitOutlined : FullscreenOutlined"
              class="ml-4 cursor-pointer" @click="toggleFullScreen" />
          </div>
          <div class="ml-4 mr-2 cursor-pointer" title="查看评论" @click="goCommentPage">
            <n-icon size="28" :component="ChatbubbleEllipsesOutline" />
          </div>
        </div>
      </div>
      <div ref="scrollContainerRef" class="detail-content" @scroll="handleScroll">
        <div class="detail-main">
          <div class="detail-left">
            <rotate-cd />
          </div>
          <div class="detail-right">
            <!-- 歌曲信息区：左对齐（网易云播放页的排版） -->
            <div class="song-info">
              <div class="song-title-row">
                <h1 ref="titleRef" class="song-title">
                  {{ mainStore.currentPlaySong?.name }}
                  <span class="song-subname" v-if="mainStore.currentPlaySong?.tns?.length">( {{
                    mainStore.currentPlaySong.tns[0] }} )</span>
                </h1>
                <span v-if="qualityTag" class="quality-tag">{{ qualityTag }}</span>
              </div>
              <p v-if="mainStore.currentPlaySong?.alia?.length" class="song-alias">
                {{ mainStore.currentPlaySong.alia[0] }}
              </p>
              <p class="song-meta">
                <span class="meta-label">专辑：</span>
                <span class="meta-value">{{ mainStore.currentPlaySong?.al?.name || '未知专辑' }}</span>
                <span class="meta-label">歌手：</span>
                <span class="meta-value">{{ artistText }}</span>
              </p>
            </div>
            <music-lyric />
          </div>
        </div>
      </div>
    </div>
  </transition>
  <transition name="bottom-slide-transform">
    <canvas v-show="mainStore.showMusicDetail" ref="myCanvas" class="background" @contextmenu="handleContextMenu" />
  </transition>

  <n-back-top style="z-index: 9999;" :show="showBackTop" :on-update:show="handleUpdateShow" :listen-to="target"
    :bottom="90" :right="400">
    <n-icon :component="BackToTop" />
  </n-back-top>
</template>

