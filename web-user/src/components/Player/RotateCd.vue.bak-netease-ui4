<script setup lang="ts">
import { useMainStore } from '@/stores/main';
import playBar from '@/assets/img/play-bar.png';
import { computed, ref, watch } from 'vue';
import { MusicalNotes } from '@vicons/ionicons5';
import useThemeStyle from '@/hook/useThemeStyle';

let maxCircleLine = 7;
let rotate = ref(0);
let cancelAnimationFrameId: number;
const mainStore = useMainStore();
const { baseColor } = useThemeStyle();
// 封面兜底：部分歌曲专辑信息不全（al 缺失或 picUrl 为空）时用占位图标，避免破图
const coverUrl = computed(() => mainStore.currentPlaySong?.al?.picUrl || '');
watch([() => mainStore.playing, () => mainStore.playWaiting], ([playing, playWaiting]) => {
  if (playing && !playWaiting) {
    cancelAnimationFrameId = window.requestAnimationFrame(loopSetRotate);
  } else {
    window.cancelAnimationFrame(cancelAnimationFrameId);
  }
});
let start: undefined | number;
const loopSetRotate = (timestamp: number) => {
  if (start === undefined) {
    start = timestamp;
  }
  const elapsed = timestamp - start;
  if (elapsed > 1000) { // 在两秒后停止动画
    rotate.value = rotate.value + 12;
    start = timestamp;
  }
  cancelAnimationFrameId = window.requestAnimationFrame(loopSetRotate);
};
</script>

<template>
  <div class="wrapContainer">
    <div class="playerBarContainer" :style="{ transform: mainStore.playing ? 'rotate(0deg)' : 'rotate(-40deg)' }">
      <img :src="playBar" class="playBar" alt="">
      <div class="playBarSupport">
        <div class="center">
          <div class="dot" />
        </div>
      </div>
    </div>
    <div class="cd" :class="mainStore.isDark ? 'cd-dark' : 'cd-light'">
      <div class="blackCenter" :style="{ transform: `rotate(${rotate}deg)` }">
        <div v-for="item in maxCircleLine" :key="item" class="rounded-full circleItem" :style="{ '--i': item }" />
        <div class="imgBg">
          <img v-if="coverUrl" crossorigin="anonymous" :src="coverUrl" alt="">
          <div v-else class="coverFallback">
            <n-icon :component="MusicalNotes" :size="36" />
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

