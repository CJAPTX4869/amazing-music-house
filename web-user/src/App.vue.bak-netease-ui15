<script setup lang="ts">
import LayOut from '@/components/Layout/Layout.vue';
import AppBackground from '@/components/Layout/components/AppBackground.vue';
import { useMainStore } from './stores/main';
const mainStore = useMainStore();
import { computed, onMounted, watchEffect } from 'vue';
import type { GlobalThemeOverrides } from 'naive-ui';
import { darken, lighten } from '@/utils/color';

// 主题主色 → Naive UI 组件色（hover/pressed 由主色自动派生，保证任意颜色和谐）
const themeOverrides = computed<GlobalThemeOverrides>(() => {
  const primary = mainStore.primaryColor;
  return {
    common: {
      primaryColor: primary,
      primaryColorHover: lighten(primary, 0.1),
      primaryColorPressed: darken(primary, 0.1),
      primaryColorSuppl: primary
    }
  };
});

// 主题主色 → CSS 变量（艺术字渐变等原生样式跟随换色）
watchEffect(() => {
  document.documentElement.style.setProperty('--primary', mainStore.primaryColor);
});


onMounted(() => {
  mainStore.initDocumentTheme();
  let media = window.matchMedia('(prefers-color-scheme: dark)');
  media.addEventListener('change', (e) => {
    mainStore.changeTheme(e.matches
      ? 'dark'
      : 'light');
  });
});
</script>
<template>
  <n-config-provider :theme="mainStore.activeTheme" :theme-overrides="themeOverrides">
    <n-loading-bar-provider>
      <div class="w-100vw app-content">
        <app-background />
        <n-message-provider>
          <n-dialog-provider>
            <LayOut />
          </n-dialog-provider>
        </n-message-provider>
      </div>
    </n-loading-bar-provider>
  </n-config-provider>
</template>

<style>
