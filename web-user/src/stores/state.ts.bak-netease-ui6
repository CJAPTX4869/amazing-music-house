import type { AnyObject } from './../../env.d';
export interface StoreState{
  theme: 'dark' | 'light',
  backTopLeft: string;
  isLogin: boolean;
  likeSongs: number[];
  playList: any[];
  userProfile: AnyObject;
  currentPlayIndex: number;
  playMode: playMode,
  playWaiting:boolean;
  currentPlayListId: string,
  playing:boolean,
  mySubscribeSongList:any[],
  playListIdList:string[],
  searchHistory:string[];
  showMusicDetail:boolean;
  searchKeyword:string;
  currentPlayLyric:string;
  canvasBackground?:string;
  primaryColorMap:AnyObject;
  /** 自定义背景图（dataURL 或网络 URL；空串表示未设置） */
  appBgImage:string;
  /** 背景遮罩强度（0-100，越大背景越淡、内容越清晰） */
  appBgMask:number;
  /** 全局主题主色（hex），驱动 Naive UI 组件色与 CSS 变量 */
  primaryColor:string;
  /** 播放页封面模糊背景层的不透明度（0-100）：只作用于播放页，与主页自定义背景互不影响 */
  playerBgOpacity:number;
  /** 播放页歌词字体颜色（hex；空串表示跟随主题默认色） */
  playerLyricColor:string;
}
export type playMode = 'order' | 'random' | 'singleLoop';
const initState = (
  key:string, defaultVal:any, parse=true
) => {
  const raw = localStorage[key];
  if (!raw) return defaultVal;
  if (!parse) return raw;
  // localStorage 可能被手工改坏或残留旧版本格式，解析失败时回落默认值并清除坏值，
  // 避免 store 初始化抛异常导致整个应用白屏
  try {
    return JSON.parse(raw);
  } catch (e) {
    console.warn(`[store] localStorage.${key} 解析失败，已重置为默认值`, e);
    localStorage.removeItem(key);
    return defaultVal;
  }
};
const state:StoreState = { 
  theme: initState(
    'theme', 'light', false
  ),
  backTopLeft: initState(
    'backTopLeft', '7vw', false
  ),
  canvasBackground:initState(
    'canvasBackground', 'var(--n-color);', false
  ),
  isLogin: initState('isLogin', false),
  userProfile: initState('userProfile', {}),
  likeSongs: initState('likeSongs', []),
  playList: initState('playList', []),
  currentPlayIndex: initState('currentPlayIndex', 0),
  playMode: initState(
    'playMode', 'order', false
  ),
  currentPlayListId: initState(
    'currentPlayListId', '', false
  ),
  mySubscribeSongList: initState('mySubscribeSongList', []),
  playListIdList: initState('playListIdList', []),
  searchHistory: initState('searchHistory', []),
  searchKeyword: '',
  playWaiting: true,
  playing: false,
  showMusicDetail: false,
  currentPlayLyric: '',
  primaryColorMap: initState('primaryColorMap', {}),
  appBgImage: initState('appBgImage', '', false),
  appBgMask: Number(initState('appBgMask', 72, false)) || 0,
  primaryColor: initState('primaryColor', '#18a058', false),
  // 播放页背景透明度：默认 55%；localStorage 被改坏时回落默认值
  playerBgOpacity: (() => {
    const raw = localStorage.playerBgOpacity;
    if (raw === undefined || raw === '') return 55;
    const num = Number(raw);
    return Number.isFinite(num)
      ? Math.min(100, Math.max(0, num))
      : 55;
  })(),
  // 播放页歌词颜色：空串 = 跟随主题
  playerLyricColor: initState('playerLyricColor', '', false),
};

export default state;